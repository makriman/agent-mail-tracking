{
  "name": "agent-mail-track",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source, self-hostable email telemetry for AI agents. Track opens, clicks, and delivery in a form agents can read and act on.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply agent-mail-track --local",
    "db:migrate:remote": "wrangler d1 migrations apply agent-mail-track --remote",
    "types": "wrangler types",
    "check": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json && vitest run",
    "test": "vitest run",
    "send-tracked": "tsx client/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.9.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.15.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.37.1"
  }
}
